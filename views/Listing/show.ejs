<%- layout('layouts/boilerplate') %>



<div class="container py-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/listing">All Listings</a></li>
      <li class="breadcrumb-item active" aria-current="page"><%= listing.title %></li>
    </ol>
  </nav>

  <div class="listing-details-card shadow rounded-4 overflow-hidden mb-5">
    <div class="row g-0">
      
      <!-- Image Section -->
      <div class="col-lg-7">
        <div class="image-container position-relative h-100">
          <div class="ratio ratio-16x9 h-100">
            <img 
              src="<%= listing.image?.url || '/images/default-listing-large.jpg' %>" 
              alt="<%= listing.title %>" 
              class="img-fluid object-fit-cover"
              onerror="this.src='/images/default-listing-large.jpg'"
              loading="lazy">
          </div>
          
          <!-- Rating Badge -->
          <div class="position-absolute top-0 end-0 p-3">
            <span class="badge bg-success bg-opacity-90 text-white fs-6 shadow-sm">
              <i class="bi bi-star-fill me-1"></i> <%= listing.rating || 'New' %>
            </span>
          </div>
        </div>
      </div>

      <!-- Details Section -->
      <div class="col-lg-5 d-flex flex-column bg-light">
        <div class="p-4 p-lg-5 h-100 d-flex flex-column">
          
          <h1 class="display-5 fw-bold mb-3 text-primary"><%= listing.title %></h1>
          
          <div class="d-flex align-items-center mb-4 text-muted">
            <i class="bi bi-geo-alt-fill text-primary me-2 fs-5"></i>
            <span class="fs-6"><%= listing.location %>, <%= listing.country %></span>
          </div>

          <div class="price-display mb-4">
            <span class="text-success fw-bold fs-3">
              ₹<%= listing.price ? new Intl.NumberFormat('en-IN').format(listing.price) : 'N/A' %>
            </span>
            <small class="text-muted">/ night</small>
          </div>

          <hr class="my-4">

          <section class="mb-4">
            <h5 class="fw-bold mb-3">About this place</h5>
            <p class="text-muted lh-base"><%= listing.description %></p>
            <br>
            <% if (listing.owner) { %>
              <p class="text-muted"><strong>Posted by:</strong> <%= listing.owner.username %></p>
              <p class="text-muted"><strong>Contact:</strong> <%= listing.owner.email %></p>
            <% } else { %>
              <p class="text-muted"><strong>Posted by:</strong> Unknown</p>
            <% } %>
          </section>

          <section class="mb-4">
            <h5 class="fw-bold mb-3">Amenities</h5>
            <div class="d-flex flex-wrap gap-2">
              <span class="badge bg-white text-dark border py-2 px-3">
                <i class="bi bi-wifi me-1 text-primary"></i> WiFi
              </span>
              <span class="badge bg-white text-dark border py-2 px-3">
                <i class="bi bi-tv me-1 text-primary"></i> TV
              </span>
              <span class="badge bg-white text-dark border py-2 px-3">
                <i class="bi bi-thermometer-snow me-1 text-primary"></i> AC
              </span>
              <span class="badge bg-white text-dark border py-2 px-3">
                <i class="bi bi-cup-hot me-1 text-primary"></i> Kitchen
              </span>
            </div>
          </section>

          <div class="mt-auto d-grid gap-3">
            <a href="/listing/<%= listing._id %>/edit" class="btn btn-primary rounded-pill py-2 fw-bold">
              <i class="bi bi-pencil-square me-2"></i> Edit Listing
            </a>
            <form method="POST" action="/listing/<%= listing._id %>?_method=DELETE" class="d-grid">
              <button type="submit" class="btn btn-outline-danger rounded-pill py-2 fw-bold" 
                      onclick="return confirm('Are you sure you want to delete this listing?')">
                <i class="bi bi-trash3 me-2"></i> Delete Listing
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Review Form -->
  <% if (currentUser) { %>
  <section class="card mt-5 border-0 shadow-lg">
    <div class="card-header bg-primary text-white rounded-top-3">
      <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Write a Review</h5>
    </div>
    <div class="card-body">
      <form action="/listing/<%= listing._id %>/reviews" method="POST">
        <div class="mb-4">
          <label class="form-label fw-semibold">Your Rating</label>
          <div class="rating-input mb-2 d-flex align-items-center">
            <% for (let i = 1; i <= 5; i++) { %>
              <span class="star-select fs-2 me-1" data-value="<%= i %>" style="cursor: pointer; color: #ccc;">★</span>
            <% } %>
            <span class="ms-2 text-muted" id="ratingText">3 stars</span>
            <input type="hidden" name="review[rating]" id="ratingValue" value="3" required>
          </div>
        </div>

        <div class="mb-4">
          <label for="comment" class="form-label fw-semibold">Your Review</label>
          <textarea class="form-control border-2" id="comment" name="review[comment]" rows="4" 
                    placeholder="Share your experience..." required></textarea>
        </div>

        <button type="submit" class="btn btn-success px-4 py-2 fw-bold">
          <i class="bi bi-send-fill me-2"></i>Submit Review
        </button>
      </form>
    </div>
  </section>
  <% } else { %>
    <div class="alert alert-warning mt-4" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      Please <a href="/login" class="alert-link">log in</a> to write a review.
    </div>
  <% } %>
  <!-- Closing the if statement for currentUser -->
  

  <!-- Reviews List -->
  <% if (listing.reviews && listing.reviews.length > 0) { %>
    <h4 class="mt-5 mb-4 d-flex align-items-center">
      <i class="bi bi-chat-square-quote-fill text-primary me-2"></i>Customer Reviews
    </h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">
      <% listing.reviews.forEach(review => { %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0 hover-effect">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                  <h6 class="card-title mb-1 fw-semibold">
<i class="bi bi-person-circle me-2 text-primary"></i>@<%= review.author.username %>

                  </h6>
                  <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString() %></small>
                </div>
                <div class="text-warning">
                  <% for (let i = 1; i <= review.rating; i++) { %>
                    <i class="bi bi-star-fill"></i>
                  <% } %>
                  <% for (let i = review.rating + 1; i <= 5; i++) { %>
                    <i class="bi bi-star"></i>
                  <% } %>
                </div>
              </div>
              <p class="card-text lh-base"><%= review.comment %></p>
            </div>
            <div class="card-footer bg-transparent border-top-0 text-end">
<% if (currentUser && review.author._id.toString() === currentUser._id.toString()) { %>
  <form method="POST" action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
    <button class="btn btn-sm btn-outline-danger">
      <i class="bi bi-trash me-1"></i>Delete
    </button>
  </form>
<% } %>

              

            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<style>
  /* Main Listing Styles */
  .listing-details-card {
    border: none;
    transition: transform 0.3s ease;
  }
  
  .listing-details-card:hover {
    transform: translateY(-5px);
  }
  
  .image-container {
    background-color: #f8f9fa;
    overflow: hidden;
  }
  
  .image-container img {
    transition: transform 0.5s ease;
  }
  
  .image-container:hover img {
    transform: scale(1.03);
  }
  
  /* Rating Stars */
  .rating-input .star-select {
    transition: all 0.2s ease;
  }
  
  .rating-input .star-select:hover {
    transform: scale(1.2);
  }
  
  /* Review Cards */
  .hover-effect {
    transition: all 0.3s ease;
    border-radius: 10px;
  }
  
  .hover-effect:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  
  /* Form Elements */
  textarea.form-control {
    min-height: 120px;
    border: 2px solid #dee2e6;
    transition: border-color 0.3s ease;
  }
  
  textarea.form-control:focus {
    border-color: #86b7fe;
    box-shadow: 0 0 0 0.25rem rgba(13,110,253,.15);
  }
  
  /* Responsive Adjustments */
  @media (max-width: 992px) {
    .listing-details-card .col-lg-7, 
    .listing-details-card .col-lg-5 {
      width: 100%;
    }
    
    .image-container {
      height: 300px;
    }
  }
  
  @media (max-width: 768px) {
    .display-5 {
      font-size: 2.2rem;
    }
    
    .card-body {
      padding: 1.25rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.star-select').forEach(star => {
    star.addEventListener('mouseover', function() {
      const value = this.getAttribute('data-value');
      document.querySelectorAll('.star-select').forEach((s, i) => {
        s.style.color = i < value ? '#ffc107' : '#e4e5e9';
      });
    });
    
    star.addEventListener('click', function() {
      const value = this.getAttribute('data-value');
      document.getElementById('ratingValue').value = value;
      document.getElementById('ratingText').textContent = value + (value == 1 ? ' star' : ' stars');
      document.querySelectorAll('.star-select').forEach((s, i) => {
        s.style.color = i < value ? '#ffc107' : '#e4e5e9';
      });
    });
  });
  
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.star-select').forEach((s, i) => {
      s.style.color = i < 3 ? '#ffc107' : '#e4e5e9';
    });
  });
</script>